@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post" style="display:inline">
        <button type="submit" style="background:none;border:none;color:inherit;text-decoration:underline;cursor:pointer">Log out</button>
    </form>
}
else
{
    <a asp-area="Identity" asp-page="/Account/Login">Log in</a>
    <span> | </span>
    <a asp-area="Identity" asp-page="/Account/Register">Register</a>
}
