<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ballot Tracking</title>
    <link rel="stylesheet" href="~/css/app.css" />
    <link rel="stylesheet" href="~/ccballot.styles.css" />
</head>
<body>
    <div class="page">
        <main>
            <article class="content px-4">
                @RenderBody()
            </article>
        </main>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
