<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.*" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="CopyToRepoRoot" AfterTargets="Publish">
    <ItemGroup>
      <_WwwRoot Include="$(PublishDir)\wwwroot\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_WwwRoot)"
          DestinationFiles="@(_WwwRoot->'$(MSBuildProjectDirectory)\..\%(RecursiveDir)%(Filename)%(Extension)')" />
    <PropertyGroup>
      <_IndexPath>$(MSBuildProjectDirectory)\..\index.html</_IndexPath>
    </PropertyGroup>
    <ReadLinesFromFile File="$(_IndexPath)">
      <Output TaskParameter="Lines" ItemName="_IndexLines" />
    </ReadLinesFromFile>
    <WriteLinesToFile File="$(_IndexPath)"
        Lines="@(_IndexLines->Replace('href=&quot;/&quot;', 'href=&quot;/CCBallot/&quot;'))"
        Overwrite="true" />
  </Target>

</Project>